                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                    android:textSize="13.5sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/t3_label"
