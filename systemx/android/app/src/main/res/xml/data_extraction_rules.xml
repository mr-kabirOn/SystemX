<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer settings only. History and test
     results stay on the device, and permission bookkeeping is per device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="systemx_permissions.xml" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="systemx_permissions.xml" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
