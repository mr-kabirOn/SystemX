<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="checkup"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_monochrome"
        android:shortcutShortLabel="@string/sc_checkup">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="systemx://open/checkup"
            android:targetClass="com.systemx.app.MainActivity"
            android:targetPackage="com.systemx.app" />
